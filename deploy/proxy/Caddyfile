# Caddyfile — automatic HTTPS for brega via Let's Encrypt.
#
# Used by the `caddy` service in docker-compose.yml (`--profile tls`). Caddy
# terminates TLS and reverse-proxies everything to the brega-web container,
# which serves the console and proxies the API to brega-server. BREGA_DOMAIN and
# BREGA_ACME_EMAIL come from your .env.
#
# Requirements: a public DNS A/AAAA record for {$BREGA_DOMAIN} pointing at this
# host, with ports 80 and 443 reachable from the internet.

{$BREGA_DOMAIN} {
	encode gzip zstd
	reverse_proxy brega-web:80
	tls {$BREGA_ACME_EMAIL}
}
